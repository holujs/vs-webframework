{
  "name": "test-web-servers",
  "version": "1.0.0",
  "description": "Reproducible HTTP and startup benchmarks for Node.js web frameworks",
  "scripts": {
    "clean": "node bench/clean.mts",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier . --check",
    "format": "prettier . --write",
    "test": "npm run build && node --test dist/bench/tests/*.mjs",
    "smoke": "npm run build && node dist/bench/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && node dist/bench/latest.mjs --check && node dist/bench/smoke.mjs",
    "bench": "npm run build && node dist/bench/run.mjs",
    "report": "node dist/bench/render.mjs",
    "results:publish": "npm run build && node dist/bench/publish.mjs",
    "results:latest": "npm run build && node dist/bench/latest.mjs",
    "node": "node dist/bench/serve.mjs node",
    "express": "node dist/bench/serve.mjs express",
    "koa": "node dist/bench/serve.mjs koa",
    "fastify": "node dist/bench/serve.mjs fastify",
    "hapi": "node dist/bench/serve.mjs hapi",
    "holu": "node dist/bench/serve.mjs holu",
    "nestjs-node": "node dist/bench/serve.mjs nestjs-node",
    "nestjs-express": "node dist/bench/serve.mjs nestjs-express",
    "nestjs-fastify": "node dist/bench/serve.mjs nestjs-fastify",
    "holu-trace": "node --trace-opt --trace-deopt dist/bench/serve.mjs holu > v8.log 2>&1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hapi/hapi": "^21.4.10",
    "@holu/core": "^0.3.0",
    "@holu/rest": "^0.3.0",
    "@koa/router": "^15.7.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/platform-node": "^12.3.2",
    "express": "^5.2.1",
    "fastify": "^5.12.7",
    "koa": "^3.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/koa": "^3.0.3",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^25.9.5",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "private": true,
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0"
}
